generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
}

model Company {
id        Int      @id @default(autoincrement())
name      String
email     String?
phone     String?
address   String?
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

employees Employee[]
payrolls  Payroll[]
users     User[]
}

model Employee {
id            Int      @id @default(autoincrement())
employeeCode  String   @unique
firstName     String
lastName      String?
email         String   @unique
phone         String?
dateOfJoining DateTime
dateOfBirth   DateTime?
panNumber     String?
uanNumber     String?
esiNumber     String?
bankAccount   String?
bankName      String?
ifscCode      String?
isActive      Boolean  @default(true)

companyId Int
company   Company @relation(fields: [companyId], references: [id])

user            User?
salaryStructure SalaryStructure?
payrolls        Payroll[]
createdAt       DateTime @default(now())
updatedAt       DateTime @updatedAt
}

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  firstName    String?
  lastName     String?
  email        String?  @unique
  passwordHash String
  role         UserRole @default(EMPLOYEE)
  isEmailVerified Boolean @default(false)
  isActive     Boolean  @default(true)

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  employeeId Int?      @unique
  employee   Employee? @relation(fields: [employeeId], references: [id])

  emailOTPs     EmailOTP[]
  refreshTokens RefreshToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailOTP {
id        Int      @id @default(autoincrement())
userId    Int
otpHash   String
expiresAt DateTime
attempts  Int      @default(0)
usedAt    DateTime?
createdAt DateTime @default(now())

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId, expiresAt])
}

model RefreshToken {
id        Int      @id @default(autoincrement())
userId    Int
tokenHash String   @unique
expiresAt DateTime
revokedAt DateTime?
createdAt DateTime @default(now())

user User @relation(fields: [userId], references: [id], onDelete: Cascade)

@@index([userId, expiresAt])
}

model SalaryStructure {
id                Int      @id @default(autoincrement())
employeeId        Int      @unique
basicSalary       Decimal  @db.Decimal(12, 2)
hra               Decimal  @default(0) @db.Decimal(12, 2)
conveyance        Decimal  @default(0) @db.Decimal(12, 2)
medicalAllowance  Decimal  @default(0) @db.Decimal(12, 2)
specialAllowance  Decimal  @default(0) @db.Decimal(12, 2)
otherAllowance    Decimal  @default(0) @db.Decimal(12, 2)

employee Employee @relation(fields: [employeeId], references: [id])

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt
}

model Payroll {
id              Int           @id @default(autoincrement())
employeeId      Int
companyId       Int
payrollMonth    Int
payrollYear     Int
grossSalary     Decimal       @db.Decimal(12, 2)
totalDeductions Decimal       @db.Decimal(12, 2)
netSalary       Decimal       @db.Decimal(12, 2)
status          PayrollStatus @default(DRAFT)

employee Employee @relation(fields: [employeeId], references: [id])
company  Company  @relation(fields: [companyId], references: [id])

items   PayrollItem[]
payslip Payslip?

createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

@@unique([employeeId, payrollMonth, payrollYear])
}

model PayrollItem {
id        Int             @id @default(autoincrement())
payrollId Int
name      String
type      PayrollItemType
amount    Decimal         @db.Decimal(12, 2)

payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)

createdAt DateTime @default(now())
}

model Payslip {
id          Int      @id @default(autoincrement())
payrollId   Int      @unique
pdfPath     String?
generatedAt DateTime @default(now())

payroll Payroll @relation(fields: [payrollId], references: [id], onDelete: Cascade)
history PayslipHistory[]
}

model PayslipHistory {
id          Int      @id @default(autoincrement())
payslipId   Int
pdfPath     String
generatedAt DateTime @default(now())

payslip Payslip @relation(fields: [payslipId], references: [id], onDelete: Cascade)
}

enum UserRole {
SUPER_ADMIN
ADMIN
HR
PAYROLL
EMPLOYEE
}

enum PayrollStatus {
DRAFT
PROCESSED
PAID
}

enum PayrollItemType {
EARNING
DEDUCTION
}
